# Copy to infra/compose/.env.compose and replace every placeholder. Never commit the copy.
#   docker compose -f infra/compose/docker-compose.yml --env-file infra/compose/.env.compose up -d --build

# Database owner (runs migrations) and the API's runtime login (row-level security applies to it).
POSTGRES_USER=restaurantos
POSTGRES_DB=restaurantos
POSTGRES_PASSWORD=replace-with-a-long-random-owner-password
RUNTIME_PASSWORD=replace-with-a-long-random-runtime-password

# MinIO (S3-compatible uploads); the API uses the root credentials in this local stack.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
S3_BUCKET=ros-uploads

# 32+ characters; derives the QR token encryption key.
APP_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Public origins of the three frontends (cross-app links, ALLOWED_ORIGINS, APP_URL).
CONSOLE_URL=http://localhost:3000
OPS_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
APP_VERSION=compose
