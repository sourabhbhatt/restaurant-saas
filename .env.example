# Copy to .env.local for local development. Never commit real secrets.
APP_URL=http://localhost:3000
# Comma-separated origins allowed to send cookie-authenticated writes (default: APP_URL's origin only).
# List all three frontends, or writes from ops and admin are rejected as cross-site.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Base URL printed on table QR codes (default: APP_URL).
# QR_BASE_URL=https://qr.example.com
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://restaurantos:restaurantos@localhost:5432/restaurantos_dev
# Zero-install alternative (embedded Postgres 18). Use an absolute path: the API runs in apps/api.
# DATABASE_PROVIDER=pglite
# PGLITE_DATA_DIR=/absolute/path/to/repo/.data/pglite
APP_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
EMAIL_PROVIDER=outbox
STORAGE_PROVIDER=local
REALTIME_PROVIDER=memory
ENABLE_TEST_HOOKS=false
# Count of proxies you control that overwrite or append X-Forwarded-For (0 = none; the header is ignored).
# Required in production. 0 for plain `pnpm dev`: the frontends forward the client's header unchanged,
# so they are not a trusted hop. Compose (Caddy edge) and Cloud Run use 1.
TRUSTED_PROXY_HOPS=0
# Optional, 16+ chars, same value on the API and on every frontend: the frontends' /api/v1 proxy then
# forwards the browser's address in a signed header, so per-IP rate limits see each client instead of
# the proxy's own egress address. Needed wherever the frontends reach the API over its public URL
# (Cloud Run); not needed for plain `pnpm dev`.
# PROXY_SHARED_SECRET=
# Online subscription payments (Razorpay Orders + Standard Checkout), TEST MODE ONLY: a key id that
# does not start with rzp_test_ makes startup fail. `none` keeps the manual upgrade-request flow only.
# With `razorpay`, all three keys are required. Get them from dashboard.razorpay.com in Test Mode.
PAYMENT_PROVIDER=none
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Growth analytics (GA4), off by default: nothing is sent and no script loads without these.
# Use a separate GA4 property per environment; never put production values in local or staging.
# See docs/growth/analytics-events.md. API: server events through the Measurement Protocol.
# TRACKING_PROVIDER=none
# GA_MEASUREMENT_ID=
# GA_API_SECRET=
# Console only (its own environment): GA_MEASUREMENT_ID shows the consent banner; GA_DEBUG_MODE=true
# sends events to DebugView (staging).

# --- Monorepo (Phase 4) ---
# Frontends (console :3000, ops :3001, admin :3002) proxy /api/v1 to the API service at request time.
API_INTERNAL_URL=http://localhost:4000
# Public origins of the three frontends, for cross-app links (read at request time, never baked in).
CONSOLE_URL=http://localhost:3000
OPS_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# Reported by /healthz and /api/v1/health.
# APP_VERSION=
