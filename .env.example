# Copy to .env.local for local development. Never commit real secrets.
APP_URL=http://localhost:3000
# Comma-separated origins allowed to send cookie-authenticated writes (default: APP_URL's origin only).
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Base URL printed on table QR codes (default: APP_URL).
# QR_BASE_URL=https://qr.example.com
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://restaurantos:restaurantos@localhost:5432/restaurantos_dev
APP_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
EMAIL_PROVIDER=outbox
STORAGE_PROVIDER=local
REALTIME_PROVIDER=memory
ENABLE_TEST_HOOKS=false
# Count of proxies you control in front of this app (0 = none; X-Forwarded-For is ignored). Required in production.
TRUSTED_PROXY_HOPS=0
# Online subscription payments (Razorpay Orders + Standard Checkout). `none` keeps the manual
# upgrade-request flow only. With `razorpay`, all three keys are required or startup fails.
PAYMENT_PROVIDER=none
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
