# Copy to .env.local for local development. Never commit real secrets.
APP_URL=http://localhost:3000
# Comma-separated origins allowed to send cookie-authenticated writes (default: APP_URL's origin only).
# List all three frontends, or writes from ops and admin are rejected as cross-site.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Base URL printed on table QR codes (default: APP_URL).
# QR_BASE_URL=https://qr.example.com
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://restaurantos:restaurantos@localhost:5432/restaurantos_dev
# Zero-install alternative (embedded Postgres 18). Use an absolute path: the API runs in apps/api.
# DATABASE_PROVIDER=pglite
# PGLITE_DATA_DIR=/absolute/path/to/repo/.data/pglite
APP_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
EMAIL_PROVIDER=outbox
STORAGE_PROVIDER=local
REALTIME_PROVIDER=memory
ENABLE_TEST_HOOKS=false
# Count of proxies you control in front of the API (0 = none; X-Forwarded-For is ignored). Required in production.
# 1 locally: every browser request reaches the API through a frontend's /api/v1 proxy.
TRUSTED_PROXY_HOPS=1
# Online subscription payments (Razorpay Orders + Standard Checkout). `none` keeps the manual
# upgrade-request flow only. With `razorpay`, all three keys are required or startup fails.
# TEST MODE ONLY: the key id must start with rzp_test_; a live key refuses startup (no override).
PAYMENT_PROVIDER=none
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Monorepo (Phase 4) ---
# Frontends (console :3000, ops :3001, admin :3002) proxy /api/v1 to the API service at request time.
API_INTERNAL_URL=http://localhost:4000
# Public origins of the three frontends, for cross-app links (read at request time, never baked in).
CONSOLE_URL=http://localhost:3000
OPS_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
# Reported by /healthz and /api/v1/health.
# APP_VERSION=
