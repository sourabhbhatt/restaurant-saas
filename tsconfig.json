{
  "extends": "./packages/tooling/tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/composition/*": ["./apps/api/src/composition/*"],
      "@/handlers/*": ["./apps/api/src/handlers/*"],
      "@/test/*": ["./apps/api/src/test/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "apps", "packages", ".worktrees"]
}
