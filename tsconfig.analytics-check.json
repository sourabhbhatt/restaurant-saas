{
  "extends": "./packages/tooling/tsconfig.base.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": ["./apps/api/src/*"]
    }
  },
  "include": [
    "packages/web-core/src/features/analytics/**/*",
    "packages/domain/src/analytics/**/*",
    "packages/contracts/src/analytics.ts",
    "packages/application/src/modules/analytics/**/*",
    "apps/api/src/composition/analytics.ts",
    "packages/database/src/providers/postgres/repositories/analytics.ts",
    "apps/api/src/app/api/v1/branches/[[]branchId]/analytics/**/*",
    "apps/api/src/app/api/v1/workspaces/[[]workspaceId]/analytics/**/*",
    "apps/api/src/app/api/v1/admin/analytics/**/*",
    "apps/console/src/app/app/w/[[]workspaceId]/page.tsx",
    "apps/console/src/app/app/w/[[]workspaceId]/analytics/**/*",
    "apps/console/src/app/app/b/[[]branchId]/page.tsx",
    "apps/console/src/app/app/b/[[]branchId]/reports/**/*",
    "apps/admin/src/app/admin/page.tsx",
    "apps/api/src/test/fixtures-analytics.ts",
    "apps/api/tests/integration/analytics*.test.ts"
  ]
}
