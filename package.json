{
  "name": "restaurant-saas-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "turbo run lint && eslint --max-warnings=0 .",
    "lint:fix": "turbo run lint -- --fix && eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:codemod": "node --test scripts/codemod-imports.test.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "codemod:imports": "node scripts/codemod-imports.mjs",
    "db:generate": "pnpm --filter @ros/database db:generate",
    "db:migrate": "tsx --env-file=.env.local packages/database/scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local apps/api/scripts/seed.ts",
    "db:snapshot": "tsx --env-file=.env.local packages/database/scripts/db-snapshot.ts",
    "db:dump": "tsx --env-file=.env.local packages/database/scripts/db-dump.ts",
    "db:restore": "tsx --env-file=.env.local packages/database/scripts/db-restore.ts",
    "db:verify": "tsx --env-file=.env.local packages/database/scripts/db-verify.ts",
    "db:revoke-cookie-jar": "tsx --env-file=.env.local packages/database/scripts/revoke-cookie-jar.ts",
    "db:make-admin": "tsx --env-file=.env.local packages/database/scripts/make-admin.ts",
    "db:studio": "pnpm --filter @ros/database db:studio",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/eslint-plugin-query": "^5.105.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
